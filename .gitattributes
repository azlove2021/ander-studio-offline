# 统一行尾，避免跨平台差异与 Windows 批处理失效
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.txt   text eol=lf

# 二进制资源不做行尾转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
