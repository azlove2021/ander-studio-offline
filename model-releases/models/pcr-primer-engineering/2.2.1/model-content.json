  "parameters": {
    "initialDuplexes": 1,
    "cycles": 3,
    "presentationSeconds": 48.1,
    "explicitStrandsPerMode": 16,
    "temperaturesC": {
      "denature": 95,
      "anneal": 55,
      "extend": 72
    }
  },
  "science": {
    "restriction": {
      "fivePrimeTail": true,
      "threePrimeAnnealing": true,
      "protectiveBases": 4,
      "siteExamples": [
        "EcoRI GAATTC",
        "BamHI GGATCC"
      ],
      "doubleStrandedSiteFirstCycle": 2,
      "bothDoubleStrandedSitesFirstCycle": 3,
      "thirdCycleExactTargets": 2,
      "separateHomologyDomains": true
    },
    "mutation": {
      "region": "forward primer annealing region only",
      "zeroBasedPosition": 24,
      "originalPair": "T-A",
      "primerMismatch": "C-A",
      "mutatedPair": "C-G",
      "complementaryMutationFirstCycle": 2,
      "exactMutantDuplexFirstCycle": 3,
      "firstThreeCycleClasses": {
        "wildtype": [
          1,
          1,
          1
        ],
        "mismatch": [
          1,
          2,
          3
        ],
        "mutant": [
          0,
          1,
          4
        ]
      }
    },
    "assumptions": [
      "Finite 84-position illustrative template; internal gene target [15,69).",
      "Ideal full extension, one specific pair of primers per mode, 100 percent amplification.",
      "No late random reannealing, nonspecific amplification, plateau effect or non-templated A addition.",
      "Not whole-plasmid QuikChange or arbitrary gene-internal mutagenesis.",
      "Sequence and temperature values are teaching examples, not an experimental protocol."
    ],
    "preserveOriginalStrands": true,
    "primerIntegratedInDaughter": true,
    "extensionDirection": "5 to 3",
    "synthesisEnd": "current template end",
    "unpairedTailsAndMismatchesHaveNoBonds": true
  },
  "presentation": {
    "fixedNodes": true,
    "timeUnit": "seconds",
    "phaseState": "single deterministic timeline",
    "inactiveOpacity": 0.28,
    "firstPrimerMotion": "Initial primers remain straight during placement and first denaturation; nonpaired tails bend upon annealing.",
    "groupedExtension": "Identical product classes extend in parallel, classes observed in sequence; real classes can also be concurrent.",
    "localZoom": "Shares exactly the same strand positions, per-residue offsets, visible synthesis intervals and orientation as the main scene.",
    "stopsAfterCycle": 3,
    "laterPrimerMotion": "Cycles 2 and 3 contain no new primers during denaturation; fresh primers enter from the left during annealing.",
    "thirdCycleScale": 0.7209302325581396,
    "rightSideMoleculeNames": false,
    "siteHighlight": "Blue outline and pale-blue ribbon over the six recognition bases, with a cyan halo.",
    "mismatchShape": "A small local peak at the substituted C, retained as a teaching marker until its correct complement is formed; no inserted base."
  },
